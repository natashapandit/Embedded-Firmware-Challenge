#include "spsc_ringbuf.h"

void ringbuf_init(ringbuf_t *rb, uint8_t *storage, size_t capacity){
    rb->buffer = storage; // storage contains the memory location for the buffer
    rb->head = 0;
    rb->tail = 0;
    rb->capacity = capacity;
}

bool ringbuf_push(ringbuf_t *rb, uint8_t byte){ // producer - enqueue
    if(rb->capacity < 2){ // capacity of 1 cant hold any elements
        return false;
    }
    size_t next_tail = (rb->tail + 1) % rb->capacity; // updates where tail is pointing and wraps around if capacity reached (ex: 5%5 = 0)
    if(next_tail == rb->head){
        return false;
    }
    rb->buffer[rb->tail] = byte; // push new val to buffer
    rb->tail = next_tail; // update tail

    return true;
}

bool ringbuf_pop(ringbuf_t *rb, uint8_t *out){ // consumer - dequeue
    if(rb->capacity < 2){ // capacity of 1 cant hold any elements
        return false;
    }
    size_t next_head = (rb->head + 1) % rb->capacity;
    if(rb->head == rb->tail){
        return false;
    }
    *out = rb->buffer[rb->head]; // assign popped value to out
    rb->head = next_head; // update head

    return true;
}

size_t ringbuf_get_used(const ringbuf_t *rb){
    return (rb->tail - rb->head + rb->capacity) % rb->capacity; // difference between indices adjusted for wrap around and empty
}

size_t ringbuf_get_free(const ringbuf_t *rb){
    return rb->capacity - 1 - ringbuf_get_used(rb); // capacity minus tail minus indices used
}